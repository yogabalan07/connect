rules_version = '2';

// ---------------------------------------------------------------------------
// Production policy for the Connect campus hub.
//
// Layers
//   users/{uid}                  the directory (Firebase Auth UID is identity)
//   doubts/{doubtId}             the question feed
//   doubts/{id}/answers/{aid}    solutions, always scoped to their doubt
//   doubts/{id}/comments/{cid}   clarifications (`answerId: ''` = doubt-level)
//   votes/{d|a}_{targetId}_{uid} one document per voter per target
//   bookmarks/{doubtId}_{uid}    saved questions
//   follows/{userId}_{uid}       member follows
//   tagFollows/{tagId}_{uid}     topic subscriptions
//   categories/{id}, tags/{id}   reference data (admin-managed)
//   notifications/{id}           per-member inbox
//   badges/{id}                  badge catalogue (admin-managed)
//   userBadges/{uid}_{badgeId}   badges a member really holds
//   reputationEvents/{id}        the reputation ledger (see below)
//
// Reputation
//   `reputation` is never stored on `users/{uid}` in a form a client can
//   move: the profile's number is an aggregation over two collections at
//   read time (`reputationEvents.delta` and nothing else). Every event is
//   validated against the very document it claims to reward, so the ledger
//   can only ever contain points that were actually earned.
//
// Language shape
//   A rules function may hold at most ten `let` bindings and must end in a
//   single `return` statement - there are no `if` blocks, no loops and no
//   early returns. Every branch below is therefore expressed with `&&` / `||`
//   (which do short-circuit) and the ternary operator, so an expensive
//   `get()` / `getAfter()` is only reached when its guard already holds.
//
// Non-negotiables enforced here (the client mirrors them but is never trusted)
//   - Approved members only: every content rule reads `users/{uid}` and
//     refuses `pending`, `rejected` and `blocked` accounts. Anonymous callers
//     are refused before any document is touched.
//   - Private doubts stay private: visibility is `public` OR author OR an
//     explicitly invited participant OR an admin. Knowing a document id is
//     never enough, and the same predicate is what a *list* request has to
//     prove, which is why `listDoubts` issues scoped queries instead of
//     pulling the collection: Firestore checks a query against its potential
//     result set, so an unfiltered read would be rejected outright.
//   - Ownership: only the author (or an admin) edits or deletes what they
//     wrote; nobody can rewrite `authorId`, `authorSnapshot.id`, `id` or the
//     creation timestamp after the document exists.
//   - Counters are derived, not declared: a vote counter may only move by the
//     exact delta implied by the caller's own `votes/{…}_{uid}` transition in
//     the same atomic write; `answersCount` may only move together with the
//     creation/deletion of the answer document named by `lastAnswerId`;
//     `views` may move up by at most 1; `hasAcceptedAnswer` must agree with
//     `acceptedAnswerId`, which in turn must agree with the answer's
//     `isAccepted` flag in the same atomic write.
//   - No role, status, reputation or moderation field is ever client-writable
//     except through the admin branches below - and never on your own record.
//
// Nothing here is ever opened with `allow read, write: if true`.
// ---------------------------------------------------------------------------
service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------- helpers

    function signedIn() {
      return request.auth != null;
    }

    function callerProfilePath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    /**
     * The caller's profile as a map: `{}` when nobody is signed in, or when
     * the `users/{uid}` document is missing. The ternary short-circuits, so
     * an anonymous request never dereferences `request.auth.uid`. Every rule
     * below starts from this single `get()`, which keeps a write well inside
     * Firestore's 10-document access budget.
     */
    function caller() {
      return signedIn() && exists(callerProfilePath())
        ? get(callerProfilePath()).data
        : {};
    }

    function approved(p) {
      return 'status' in p && p.status == 'approved';
    }

    function admin(p) {
      return 'role' in p && p.role == 'admin';
    }

    /** Epoch-millisecond timestamps: sane window, client clock, never future. */
    function saneTime(ms) {
      return ms is number
        && ms > 1577836800000
        && ms < request.time.toMillis() + 86400000;
    }

    function doubtPath(id) {
      return /databases/$(database)/documents/doubts/$(id);
    }

    function answerPath(doubtId, answerId) {
      return /databases/$(database)/documents/doubts/$(doubtId)/answers/$(answerId);
    }

    function commentPath(doubtId, commentId) {
      return /databases/$(database)/documents/doubts/$(doubtId)/comments/$(commentId);
    }

    function doubtDoc(id) {
      return get(doubtPath(id)).data;
    }

    function reputationEventPath(id) {
      return /databases/$(database)/documents/reputationEvents/$(id);
    }

    function memberStatus(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data.status;
    }

    /** Canonical `votes/{id}` a `vote` reputation event must agree with. */
    function voteDocPath(type, targetId, voterUid) {
      return /databases/$(database)/documents/votes/$((type == 'doubt' ? 'd_' : 'a_') + targetId + '_' + voterUid);
    }

    /**
     * Points one vote is worth to the content's author. A withdrawn vote
     * (`value == 0`) is worth nothing, which is what lets a retraction drop
     * the score back to where it started without deleting a ledger row.
     */
    function voteReward(targetType, value) {
      return value == 0
        ? 0
        : (targetType == 'doubt'
            ? (value == 1 ? 5 : -2)
            : (value == 1 ? 10 : -2));
    }

    /**
     * Badges a client may ever hold. Hard-coded rather than read from the
     * catalogue so an award never depends on a document a moderator happens
     * to have created first - and so an unknown id is refused at the door.
     */
    function knownBadge(id) {
      return id in [
        'first_doubt',
        'first_answer',
        'first_accepted',
        'first_comment',
        'helpful_contributor',
        'active_contributor',
        'top_contributor'
      ];
    }

    /**
     * The visibility predicate. `admin()` is tried first: it does not touch
     * the document, so a moderator's query can be proven without inspecting
     * any field, while everyone else has to satisfy one of the field
     * branches - which is exactly what the scoped feed queries guarantee.
     */
    function viewable(p, d) {
      return admin(p)
        || d.visibility == 'public'
        || d.authorId == request.auth.uid
        || request.auth.uid in d.allowedUserIds;
    }

    function canView(d) {
      let p = caller();
      return approved(p) && viewable(p, d);
    }

    // ------------------------------------------------------------- users

    /**
     * `EditableProfilePatch` - what a member may change on their own record.
     * The three links are plain display data; reputation, badges, counters,
     * `role` and `status` are all deliberately absent.
     */
    function ownerEditableKeys() {
      return [
        'displayName',
        'username',
        'department',
        'year',
        'batch',
        'bio',
        'photoURL',
        'coverImage',
        'skills',
        'github',
        'linkedin',
        'website',
        'updatedAt'
      ];
    }

    /**
     * Moderation fields. Only an admin transition may change them, and never
     * on the admin's own record: self-service `role` / `status` writes would
     * let the sole moderator demote themselves out of the system in one
     * round-trip, which nobody legitimately needs.
     */
    function adminOnlyKeys() {
      return ['role', 'status', 'updatedAt'];
    }

    match /users/{uid} {
      allow get, list: if signedIn();

      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.id == uid
        && request.resource.data.email is string
        && request.resource.data.displayName is string
        && request.resource.data.role == 'student'
        && request.resource.data.status == 'pending';

      /**
       * Book a reputation credit onto a member's public score.
       *
       * `firestore.rules` already recomputed `delta` from the work the event
       * points at (`reputationEventValid`), so what is left to prove is that
       * the event names `uid` as its beneficiary and that this write applies
       * it exactly once:
       *
       * - a milestone (`question` / `answer` / `accepted`) must be minted in
       *   THIS commit (`!exists && existsAfter`) - the deterministic id makes
       *   a second application impossible even later;
       * - a `vote` is a running total, so it is applied from the voter's own
       *   `votes/{…}` document as it stood before and after this commit. Only
       *   an actual `saveVote` can move that number, and only by the exact
       *   reward `voteReward()` returns - which is also what makes a
       *   withdrawal drop the score back by the same amount.
       *
       * Nothing here can throw: `reputationEventPath` is only reached once
       * `ref` is a non-empty string, and every other lookup is guarded.
       */
      function voteCredit(ev) {
        let vp = voteDocPath(ev.targetType, ev.targetId, request.auth.uid);
        let after = existsAfter(vp) ? getAfter(vp).data.value : 0;
        let prior = exists(vp) ? get(vp).data.value : 0;
        return voteReward(ev.targetType, after) - voteReward(ev.targetType, prior);
      }

      function reputationCreditEdit() {
        let ref = 'reputationEventRef' in request.resource.data
          ? request.resource.data.reputationEventRef : '';
        let path = ref is string && ref.size() > 0
          ? reputationEventPath(ref)
          : /databases/$(database)/documents/nowhere;
        let before = 'reputation' in resource.data ? resource.data.reputation : 0;
        let good = 'reputation' in request.resource.data
          ? request.resource.data.reputation : -1;
        let diff = request.resource.data.diff(resource.data).affectedKeys();
        return approved(caller())
          && diff.hasOnly(['reputation', 'reputationEventRef'])
          && ref is string
          && ref.size() > 0
          && good is number
          && good >= 0
          && existsAfter(path)
          && getAfter(path).data.userId == uid
          && (getAfter(path).data.type in ['question', 'answer', 'accepted']
              ? (!exists(path) && good - before == getAfter(path).data.delta)
              : (getAfter(path).data.type == 'vote'
                  && getAfter(path).data.voterId == request.auth.uid
                  && good - before == voteCredit(getAfter(path).data)));
      }

      allow update: if
        (signedIn()
          && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(ownerEditableKeys()))
        || reputationCreditEdit()
        || (admin(caller())
          && request.auth.uid != uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(adminOnlyKeys()));

      allow delete: if admin(caller());
    }

    // ------------------------------------------------------------- doubts

    match /doubts/{doubtId} {

      function contentKeys() {
        return [
          'title',
          'description',
          'category',
          'subject',
          'tags',
          'visibility',
          'allowedUserIds',
          'priority',
          'codeSnippet',
          'attachments',
          'mentions',
          'mentionIds',
          'updatedAtMs'
        ];
      }

      function validVisibility(d) {
        return d.visibility == 'private'
          ? (d.allowedUserIds is list
              && request.auth.uid in d.allowedUserIds
              && d.authorId in d.allowedUserIds)
          : (d.allowedUserIds is list && d.allowedUserIds.size() == 0);
      }

      /** `answersCount` may only move with the answer named by `lastAnswerId`. */
      function answersCountEdit() {
        return request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['answersCount', 'lastAnswerId'])
          && request.resource.data.answersCount is number
          && request.resource.data.answersCount >= 0
          && request.resource.data.lastAnswerId is string
          && answersCountMoves();
      }

      /**
       * Creating an answer names it as `lastAnswerId` and the answer document
       * appears; deleting it keeps `lastAnswerId` pointing at the removed
       * document and the answer disappears. `&&` short-circuits, so the path
       * is only probed once the delta is known.
       */
      function answersCountMoves() {
        let target = answerPath(doubtId, request.resource.data.lastAnswerId);
        let delta = request.resource.data.answersCount - resource.data.answersCount;
        return (delta == 1 && !exists(target) && existsAfter(target))
          || (delta == -1 && exists(target) && !existsAfter(target));
      }

      function acceptedFlagEdit() {
        return request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['hasAcceptedAnswer', 'acceptedAnswerId'])
          && request.resource.data.hasAcceptedAnswer is bool
          && acceptedFlagMoves();
      }

      function acceptedFlagMoves() {
        let newId = request.resource.data.acceptedAnswerId;
        let oldId = resource.data.acceptedAnswerId;
        let swapping = newId is string && oldId is string && newId != oldId;
        return request.resource.data.hasAcceptedAnswer
          ? (newId is string
              && (swapping
                  ? getAfter(answerPath(doubtId, oldId)).data.isAccepted == false
                    && getAfter(answerPath(doubtId, newId)).data.isAccepted == true
                  : getAfter(answerPath(doubtId, newId)).data.isAccepted == true))
          : request.resource.data.acceptedAnswerId == null;
      }

      /** Expected counter delta implied by the caller's own vote transition. */
      function voteBefore(path, value) {
        return exists(path) && get(path).data.value == value;
      }

      function voteAfter(path, value) {
        return existsAfter(path) && getAfter(path).data.value == value;
      }

      function expectedUpDelta(path) {
        return voteBefore(path, 1)
          ? (voteAfter(path, 1) ? 0 : -1)
          : (voteAfter(path, 1) ? 1 : 0);
      }

      function expectedDownDelta(path) {
        return voteBefore(path, -1)
          ? (voteAfter(path, -1) ? 0 : -1)
          : (voteAfter(path, -1) ? 1 : 0);
      }

      function voteCounterEdit() {
        let path = /databases/$(database)/documents/votes/$('d_' + doubtId + '_' + request.auth.uid);
        return request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['upvotes', 'downvotes'])
          && request.resource.data.upvotes is number
          && request.resource.data.downvotes is number
          && request.resource.data.upvotes >= 0
          && request.resource.data.downvotes >= 0
          && request.resource.data.upvotes - resource.data.upvotes == expectedUpDelta(path)
          && request.resource.data.downvotes - resource.data.downvotes == expectedDownDelta(path);
      }

      function viewCountEdit() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views'])
          && request.resource.data.views is number
          && request.resource.data.views >= 0
          && request.resource.data.views - resource.data.views <= 1
          && request.resource.data.views >= resource.data.views;
      }

      function updateAllowed() {
        let p = caller();
        let isAuthor = resource.data.authorId == request.auth.uid;
        let isModerator = admin(p);
        let diff = request.resource.data.diff(resource.data).affectedKeys();
        let contentEdit = (isAuthor || isModerator)
          && diff.hasOnly(contentKeys())
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 300
          && request.resource.data.description is string
          && request.resource.data.description.size() > 0
          && request.resource.data.tags is list
          && request.resource.data.visibility in ['public', 'private']
          && validVisibility(request.resource.data)
          && saneTime(request.resource.data.updatedAtMs);
        let counterEdit = viewable(p, resource.data)
          && (viewCountEdit() || voteCounterEdit());
        let acceptedEdit = (isAuthor || isModerator) && acceptedFlagEdit();
        let pinEdit = isModerator
          && diff.hasOnly(['isPinned'])
          && request.resource.data.isPinned is bool;
        return approved(p)
          && (contentEdit || counterEdit || answersCountEdit() || acceptedEdit || pinEdit);
      }

      allow get, list: if canView(resource.data);

      allow create: if approved(caller())
        && request.resource.data.id == doubtId
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.authorSnapshot is map
        && request.resource.data.authorSnapshot.id == request.auth.uid
        && request.resource.data.authorSnapshot.role == caller().role
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 300
        && request.resource.data.description is string
        && request.resource.data.description.size() > 0
        && request.resource.data.tags is list
        && request.resource.data.visibility in ['public', 'private']
        && validVisibility(request.resource.data)
        && request.resource.data.upvotes == 0
        && request.resource.data.downvotes == 0
        && request.resource.data.views == 0
        && request.resource.data.answersCount == 0
        && request.resource.data.hasAcceptedAnswer == false
        && request.resource.data.acceptedAnswerId == null
        && request.resource.data.lastAnswerId == null
        && saneTime(request.resource.data.createdAtMs);

      allow update: if updateAllowed();

      allow delete: if approved(caller())
        && (resource.data.authorId == request.auth.uid || admin(caller()));

      // ----------------------------------------------------------- answers
      match /answers/{answerId} {

        function parentDoubt() {
          return doubtDoc(doubtId);
        }

        function answerContentKeys() {
          return ['content', 'codeSnippet', 'attachments', 'mentions', 'mentionIds', 'updatedAtMs'];
        }

        function answerAcceptedFlagMatches() {
          let acceptedId = getAfter(doubtPath(doubtId)).data.acceptedAnswerId;
          return request.resource.data.isAccepted
            ? acceptedId == answerId
            : acceptedId != answerId;
        }

        function answerUpdateAllowed() {
          let p = caller();
          let doubt = parentDoubt();
          let diff = request.resource.data.diff(resource.data).affectedKeys();
          let isAuthor = resource.data.authorId == request.auth.uid;
          let mayAccept = doubt.authorId == request.auth.uid;
          let contentEdit = (isAuthor || admin(p))
            && diff.hasOnly(answerContentKeys())
            && request.resource.data.content is string
            && request.resource.data.content.size() > 0
            && saneTime(request.resource.data.updatedAtMs);
          let acceptEdit = mayAccept
            && diff.hasOnly(['isAccepted'])
            && request.resource.data.isAccepted is bool
            && answerAcceptedFlagMatches();
          let voteEdit = viewable(p, doubt) && voteCounterEdit();
          return approved(p) && (contentEdit || acceptEdit || voteEdit);
        }

        function voteCounterEdit() {
          let path = /databases/$(database)/documents/votes/$('a_' + answerId + '_' + request.auth.uid);
          return request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['upvotes', 'downvotes'])
            && request.resource.data.upvotes is number
            && request.resource.data.downvotes is number
            && request.resource.data.upvotes >= 0
            && request.resource.data.downvotes >= 0
            && request.resource.data.upvotes - resource.data.upvotes == expectedUpDelta(path)
            && request.resource.data.downvotes - resource.data.downvotes == expectedDownDelta(path);
        }

        /** Posting an answer must bump the doubt's `answersCount` by exactly 1. */
        function answerCounterMovesOnCreate() {
          let doubt = doubtDoc(doubtId);
          let after = getAfter(doubtPath(doubtId)).data;
          return after.answersCount == doubt.answersCount + 1
            && after.lastAnswerId == answerId;
        }

        /**
         * Removing an answer must drop the doubt's `answersCount` by exactly
         * 1 - unless the doubt itself is going away in the same batch, in
         * which case `getAfter()` would look at a document that no longer
         * exists and the whole cascade would be refused. The `||` is ordered
         * so that path is never probed first.
         */
        function answerCounterMovesOnDelete() {
          let parent = doubtPath(doubtId);
          return !existsAfter(parent)
            || (exists(parent)
                && getAfter(parent).data.answersCount == get(parent).data.answersCount - 1
                && getAfter(parent).data.lastAnswerId == answerId);
        }

        /**
         * The author-own branch is listed FIRST on purpose: a collection-group
         * query (`collectionGroup('answers').where('authorId','==',uid)`, which
         * is how the profile derives its answer count) proves exactly that
         * conjunction, and `||` short-circuits before `doubtDoc()` - which
         * would throw on an orphan - is ever reached. An unfiltered query can
         * prove neither side and is still refused.
         */
        allow get, list: if (approved(caller()) && resource.data.authorId == request.auth.uid)
          || canView(doubtDoc(doubtId));

        allow create: if approved(caller())
          && request.resource.data.id == answerId
          && request.resource.data.doubtId == doubtId
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.authorSnapshot is map
          && request.resource.data.authorSnapshot.id == request.auth.uid
          && request.resource.data.authorSnapshot.role == caller().role
          && request.resource.data.content is string
          && request.resource.data.content.size() > 0
          && request.resource.data.upvotes == 0
          && request.resource.data.downvotes == 0
          && request.resource.data.isAccepted == false
          && saneTime(request.resource.data.createdAtMs)
          && answerCounterMovesOnCreate();

        allow update: if answerUpdateAllowed();

        allow delete: if approved(caller()) && (
            resource.data.authorId == request.auth.uid
            || doubtDoc(doubtId).authorId == request.auth.uid
            || admin(caller())
          )
          && answerCounterMovesOnDelete();
      }

      // ---------------------------------------------------------- comments
      match /comments/{commentId} {

        /**
         * Deleting a comment cascades with its answer: the answer's author
         * clears their own thread even when the comment belongs to someone
         * else. The probe runs against the pre-write state, so it still sees
         * the answer while that answer is being removed in the same batch.
         */
        function onOwnAnswer() {
          let answerId = resource.data.answerId;
          return answerId is string && answerId != ''
            && exists(answerPath(doubtId, answerId))
            && get(answerPath(doubtId, answerId)).data.authorId == request.auth.uid;
        }

        allow get, list: if canView(doubtDoc(doubtId));

        allow create: if approved(caller())
          && canView(doubtDoc(doubtId))
          && request.resource.data.id == commentId
          && request.resource.data.doubtId == doubtId
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.content is string
          && request.resource.data.content.size() > 0
          && request.resource.data.content.size() <= 2000
          && request.resource.data.answerId is string
          // `''` marks a question-level clarification; anything else must name
          // an answer that really lives under this doubt, so a comment cannot
          // be attached to an answer from a different question.
          && (request.resource.data.answerId == ''
            || exists(answerPath(doubtId, request.resource.data.answerId)))
          && saneTime(request.resource.data.createdAtMs);

        /** The body plus its edit stamp - ownership, mentions, counters and
         *  the doubt/answer it hangs off are all immutable. Moderators may
         *  rewrite a comment they did not write. */
        allow update: if approved(caller())
          && (resource.data.authorId == request.auth.uid || admin(caller()))
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['content', 'updatedAtMs'])
          && request.resource.data.content is string
          && request.resource.data.content.size() > 0
          && request.resource.data.content.size() <= 2000
          && saneTime(request.resource.data.updatedAtMs);

        /** Own comments, anything a moderator removes, a doubt author clearing
         *  their own question's thread, and the author of the answer a comment
         *  hangs off. */
        allow delete: if approved(caller())
          && (resource.data.authorId == request.auth.uid
            || doubtDoc(doubtId).authorId == request.auth.uid
            || admin(caller())
            || onOwnAnswer());
      }
    }

    // -------------------------------------------------------------- votes
    match /votes/{voteId} {

      function expectedVoteId(v) {
        return v.targetType == 'doubt'
          ? 'd_' + v.targetId + '_' + request.auth.uid
          : 'a_' + v.targetId + '_' + request.auth.uid;
      }

      function validVote(v) {
        return voteId == expectedVoteId(v)
          && v.userId == request.auth.uid
          && v.targetType in ['doubt', 'answer']
          && v.targetId is string
          && v.doubtId is string
          && v.value in [1, -1];
      }

      function voteParent(v) {
        return v.targetType == 'doubt'
          ? doubtPath(v.targetId)
          : answerPath(v.doubtId, v.targetId);
      }

      /**
       * The vote document and the parent counters must move together: this is
       * the half of the contract that stops a client from silently minting a
       * vote record without (or in excess of) a counter change.
       */
      function parentCountersMoved(v) {
        let parent = voteParent(v);
        return get(parent).data.upvotes != getAfter(parent).data.upvotes
          || get(parent).data.downvotes != getAfter(parent).data.downvotes;
      }

      allow read: if approved(caller()) && resource.data.userId == request.auth.uid;

      allow create: if approved(caller())
        && validVote(request.resource.data)
        && parentCountersMoved(request.resource.data);

      allow update: if approved(caller())
        && resource.data.userId == request.auth.uid
        && validVote(request.resource.data)
        && parentCountersMoved(request.resource.data);

      allow delete: if approved(caller())
        && resource.data.userId == request.auth.uid
        && voteId == expectedVoteId(resource.data)
        && parentCountersMoved(resource.data);
    }

    // ---------------------------------------------------------- bookmarks
    match /bookmarks/{bookmarkId} {
      allow read: if approved(caller()) && resource.data.userId == request.auth.uid;

      allow create: if approved(caller())
        && bookmarkId == request.resource.data.doubtId + '_' + request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.doubtId is string
        && saneTime(request.resource.data.createdAtMs);

      allow delete: if approved(caller())
        && resource.data.userId == request.auth.uid
        && bookmarkId == resource.data.doubtId + '_' + request.auth.uid;
    }

    // ------------------------------------------------------------- follows
    /**
     * `follows/{targetUid}_{followerUid}`.
     *
     * Read is deliberately open to every approved member (not just the two
     * endpoints): a profile has to be able to render *someone else's*
     * followers / following lists, and the edge carries nothing private -
     * who follows whom is public on every campus network. The write side is
     * where the real constraints live:
     *   - only the caller can create an edge they are the follower in,
     *   - no self-follow,
     *   - the target must be an approved member (you cannot follow a
     *     pending, rejected or blocked account, nor a deleted one),
     *   - `update` is never granted, so an edge can never be re-pointed at
     *     a different target after the fact.
     */
    match /follows/{followId} {
      allow read: if approved(caller());

      allow create: if approved(caller())
        && followId == request.resource.data.targetUserId + '_' + request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.targetUserId is string
        && request.resource.data.targetUserId != request.auth.uid
        && memberStatus(request.resource.data.targetUserId) == 'approved'
        && saneTime(request.resource.data.createdAtMs);

      allow delete: if approved(caller())
        && resource.data.userId == request.auth.uid
        && followId == resource.data.targetUserId + '_' + request.auth.uid;
    }

    match /tagFollows/{followId} {
      allow read: if approved(caller()) && resource.data.userId == request.auth.uid;

      allow create: if approved(caller())
        && followId == request.resource.data.tagId + '_' + request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.tagId is string
        && saneTime(request.resource.data.createdAtMs);

      allow delete: if approved(caller())
        && resource.data.userId == request.auth.uid
        && followId == resource.data.tagId + '_' + request.auth.uid;
    }

    // ----------------------------------------------------------- catalog
    match /categories/{categoryId} {
      allow read: if approved(caller());

      allow create, delete: if approved(caller()) && admin(caller());

      allow update: if approved(caller()) && (
          admin(caller())
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['questionsCount'])
            && request.resource.data.questionsCount is number
            && request.resource.data.questionsCount >= 0
            && request.resource.data.questionsCount - resource.data.questionsCount in [-1, 0, 1])
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
            && request.resource.data.status in ['active', 'inactive'])
      );
    }

    match /tags/{tagId} {
      allow read: if approved(caller());

      allow create, delete: if approved(caller()) && admin(caller());

      allow update: if approved(caller()) && (
          admin(caller())
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followersCount'])
            && request.resource.data.followersCount is number
            && request.resource.data.followersCount >= 0
            && request.resource.data.followersCount - resource.data.followersCount in [-1, 0, 1])
      );
    }

    // ----------------------------------------------------- notifications
    match /notifications/{notificationId} {

      /**
       * Which event kinds a signed-in member may mint, and for whom.
       *
       * - `mention` / `answer` / `accepted` / `comment` are ordinary member
       *   events; `userId != request.auth.uid` in the create rule already
       *   stops anyone writing into their own inbox.
       * - `admin_approval` and `announcement` carry institutional authority,
       *   so only an admin may produce them - a student cannot announce.
       * - `follow` must agree with a `follows/{target}_{uid}` document the
       *   caller really created, which is what stops a fabricated
       *   "you have a new follower".
       * - `badge` and `reputation` are the ONLY self-addressed kinds, and
       *   both are pinned to a document that proves the award: the member's
       *   `userBadges/{uid}_{badgeId}` row, and the reputation event that
       *   actually credited them. Telling yourself you won a badge you never
       *   earned is therefore refused at the door.
       */
      function eventAllowed(d) {
        return d.type in ['mention', 'answer', 'accepted', 'comment']
          || (d.type in ['admin_approval', 'announcement'] && admin(caller()))
          || (d.type == 'follow'
              && exists(/databases/$(database)/documents/follows/$(d.userId + '_' + request.auth.uid)))
          || (d.type == 'reputation'
              && d.userId == request.auth.uid
              && d.sourceId is string
              && get(reputationEventPath(d.sourceId)).data.userId == request.auth.uid)
          || (d.type == 'badge'
              && d.userId == request.auth.uid
              && d.sourceId is string
              && exists(/databases/$(database)/documents/userBadges/$(d.userId + '_' + d.sourceId)));
      }

      allow read: if approved(caller()) && resource.data.userId == request.auth.uid;

      allow create: if approved(caller())
        && request.resource.data.userId is string
        // Only the two self-addressed award kinds may name their own inbox;
        // everything else still has to be somebody else's.
        && (request.resource.data.userId != request.auth.uid
          || request.resource.data.type in ['badge', 'reputation'])
        // `senderId` is the identity of whoever caused the event and can only
        // ever be the caller; `source` is stamped `client` by the adapter, so
        // a browser cannot claim to be a trusted server process.
        && request.resource.data.senderId is string
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.source == 'client'
        && request.resource.data.type in [
          'mention', 'answer', 'accepted', 'follow', 'comment',
          'admin_approval', 'announcement', 'badge', 'reputation'
        ]
        && eventAllowed(request.resource.data)
        && request.resource.data.senderName is string
        && request.resource.data.senderName.size() > 0
        && request.resource.data.senderName.size() <= 100
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 200
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 2000
        && request.resource.data.read == false
        && saneTime(request.resource.data.createdAtMs);

      /** Only the `read` flag flips, and only for the inbox's owner. */
      allow update: if approved(caller())
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
        && request.resource.data.read is bool;

      allow delete: if approved(caller()) && resource.data.userId == request.auth.uid;
    }

    // -------------------------------------------------- reputation ledger
    /**
     * `reputationEvents/{eventId}` - the only representation of reputation
     * this product trusts.
     *
     * Every event is a small, rules-proven claim about work that really
     * happened, and the id is a pure function of that work, so the same
     * milestone can never be booked twice:
     *
     *   question_{doubtId}_{uid}            +5   you asked it
     *   answer_{doubtId}_{answerId}_{uid}   +10  you answered it
     *   accepted_{answerId}_{uid}           +15  your answer was accepted
     *   vote_{targetId}_{voterUid}          +5/+10/-2  somebody voted
     *
     * The client never gets to choose `delta`: each branch below recomputes
     * it from the document the event points at, then compares. `update` is
     * only open for `vote` events (a voter may flip their own vote, which
     * changes the reward), and only the voter who cast it may do so.
     *
     * Not clawed back: reputation earned on a question/answer survives that
     * document's deletion. The event was proven when it was written, and a
     * moderation clawback belongs to a trusted backend, not to the browser.
     */
    match /reputationEvents/{eventId} {

      function questionEvent(d) {
        return d.type == 'question'
          && d.delta == 5
          && d.userId == request.auth.uid
          && d.actorId == request.auth.uid
          && d.doubtId == d.sourceId
          && eventId == 'question_' + d.sourceId + '_' + request.auth.uid
          && getAfter(doubtPath(d.sourceId)).data.authorId == request.auth.uid;
      }

      function answerEvent(d) {
        return d.type == 'answer'
          && d.delta == 10
          && d.userId == request.auth.uid
          && d.actorId == request.auth.uid
          && eventId == 'answer_' + d.doubtId + '_' + d.sourceId + '_' + request.auth.uid
          && getAfter(answerPath(d.doubtId, d.sourceId)).data.authorId == request.auth.uid;
      }

      /**
       * The acceptor is the caller, the beneficiary is the answer's author,
       * and the answer really is the accepted one *after* this write - which
       * is the same proof `doubts.acceptedAnswerId` relies on.
       */
      function acceptedEvent(d) {
        return d.type == 'accepted'
          && d.delta == 15
          && d.actorId == request.auth.uid
          && d.userId != request.auth.uid
          && eventId == 'accepted_' + d.sourceId + '_' + d.userId
          && getAfter(answerPath(d.doubtId, d.sourceId)).data.authorId == d.userId
          && getAfter(answerPath(d.doubtId, d.sourceId)).data.isAccepted == true;
      }

      /**
       * `getAfter` rather than `get`: the vote document, the event and the
       * beneficiary's score are written in ONE commit, so the only value that
       * can be trusted here is the one that will exist afterwards. A separate
       * request would read the same post-commit state, so both timings prove.
       */
      function voteEventProof(d) {
        return d.targetType in ['doubt', 'answer']
          && d.value in [-1, 0, 1]
          && d.voterId == request.auth.uid
          && eventId == 'vote_' + d.targetId + '_' + d.voterId
          // A withdrawn vote keeps its ledger row with `delta: 0` so the
          // sum drops back without needing a delete (and without a read).
          && (d.value == 0
            ? d.delta == 0
            : (d.userId != d.voterId
                && getAfter(voteDocPath(d.targetType, d.targetId, d.voterId)).data.userId == d.voterId
                && getAfter(voteDocPath(d.targetType, d.targetId, d.voterId)).data.targetId == d.targetId
                && getAfter(voteDocPath(d.targetType, d.targetId, d.voterId)).data.value == d.value
                && getAfter(voteDocPath(d.targetType, d.targetId, d.voterId)).data.doubtId == d.doubtId
                && voteParentAuthor(d) == d.userId
                && d.delta == voteReward(d.targetType, d.value)));
      }

      /** The author whose reputation a `vote` event credits. */
      function voteParentAuthor(d) {
        return d.targetType == 'doubt'
          ? get(doubtPath(d.targetId)).data.authorId
          : get(answerPath(d.doubtId, d.targetId)).data.authorId;
      }

      /** Type first, so each branch is only ever evaluated for its own kind. */
      function voteEvent(d) {
        return d.type == 'vote' && voteEventProof(d);
      }

      /**
       * The whole shape is declared up front: nothing below can trip over a
       * missing field, and an abbreviated event is refused outright.
       */
      function reputationEventValid(d) {
        return approved(caller())
          && d.id == eventId
          && d.userId is string
          && d.type in ['question', 'answer', 'accepted', 'vote']
          && d.delta is number
          && d.sourceId is string
          && d.doubtId is string
          && d.actorId is string
          && d.voterId is string
          && d.targetType is string
          && d.targetId is string
          && d.value is number
          && saneTime(d.createdAtMs)
          && (questionEvent(d) || answerEvent(d) || acceptedEvent(d) || voteEvent(d));
      }

      /**
       * Read is bounded by identity for the rows that carry a secret, and
       * open for the rows that do not. `question` / `answer` / `accepted`
       * events restate a fact the whole campus can already see on the doubt
       * page, so any approved member may count them off a profile. A `vote`
       * row names the member who cast it, which is exactly what the `votes`
       * collection keeps private - so a vote row stays between its voter and
       * its beneficiary. A query that does not pin `type` therefore fails for
       * anybody but the two of them, which is the intended fail-closed
       * behaviour (see `ReputationPage` / `profileService`).
       *
       * `!resource.exists` is listed first so a single-document probe can ask
       * "has this milestone already been booked?" and get an honest answer:
       * for a query every potential result exists, so it never weakens the
       * filter above it - it only stops `resource.data` from throwing.
       */
      allow read: if approved(caller())
        && (!resource.exists
          || resource.data.type != 'vote'
          || resource.data.userId == request.auth.uid
          || resource.data.voterId == request.auth.uid);

      allow create: if reputationEventValid(request.resource.data);

      /**
       * Re-writing an event has to pass the exact same proof as creating it,
       * and every proof is pinned to the actor who earned it (the earner's
       * own uid, the acceptor's uid, the voter's uid) and to the id derived
       * from that same work. So a retry is idempotent, while changing the
       * amount, the beneficiary or the source is refused.
       */
      allow update: if reputationEventValid(request.resource.data);

      allow delete: if approved(caller())
        && resource.data.type == 'vote'
        && resource.data.voterId == request.auth.uid;
    }

    // -------------------------------------------------------------- badges
    /**
     * `badges/{badgeId}` - the catalogue. Members read it to render the
     * profile, only a moderator may add or restate a badge.
     */
    match /badges/{badgeId} {
      allow read: if approved(caller());

      allow create, update, delete: if approved(caller()) && admin(caller());
    }

    /**
     * `userBadges/{uid}_{badgeId}` - a badge a member really holds.
     *
     * The award is always self-service (you claim what you earned) but never
     * self-declared: `badgeCriterion()` re-reads the document that proves the
     * milestone, and threshold badges - which need a count Firestore rules
     * cannot take - are moderator-only by construction.
     */
    match /userBadges/{userBadgeId} {

      function acceptedEventIsMine(sourceId) {
        let event = getAfter(reputationEventPath(sourceId)).data;
        return event.type == 'accepted' && event.userId == request.auth.uid;
      }

      function badgeCriterion(d) {
        return d.badgeId == 'first_doubt'
          ? (d.sourceId is string
              && getAfter(doubtPath(d.sourceId)).data.authorId == request.auth.uid)
          : d.badgeId == 'first_answer'
          ? (d.doubtId is string && d.sourceId is string
              && getAfter(answerPath(d.doubtId, d.sourceId)).data.authorId == request.auth.uid)
          : d.badgeId == 'first_accepted'
          ? (d.sourceId is string && acceptedEventIsMine(d.sourceId))
          : d.badgeId == 'first_comment'
          ? (d.doubtId is string && d.sourceId is string
              && getAfter(commentPath(d.doubtId, d.sourceId)).data.authorId == request.auth.uid)
          : admin(caller());
      }

      allow read: if approved(caller());

      allow create: if approved(caller())
        && request.resource.data.uid == request.auth.uid
        && userBadgeId == request.resource.data.uid + '_' + request.resource.data.badgeId
        && request.resource.data.badgeId is string
        && request.resource.data.badgeId.size() > 0
        && request.resource.data.sourceId is string
        && knownBadge(request.resource.data.badgeId)
        && saneTime(request.resource.data.awardedAtMs)
        && badgeCriterion(request.resource.data);

      /** A held badge is evidence: it is never edited, only granted/retired. */
      allow update: if false;

      allow delete: if approved(caller()) && admin(caller());
    }

    // ------------------------------------------------------------ reports
    /**
     * `reports/{reportId}` - the moderation queue.
     *
     * The id is a pure function of what was reported and by whom
     * (`{targetType}_{targetId}_{reporterId}`), so filing the same report
     * twice is an `already-exists` failure rather than a second row: that is
     * the duplicate handling the queue needs, enforced structurally.
     *
     * Read is moderator-only. A reporter never needs the row back - the UI
     * confirms immediately - and a queue nobody outside the moderators can
     * open is one less shape a query has to prove.
     */
    match /reports/{reportId} {

      function validReportTarget(t) {
        return t in ['doubt', 'answer', 'user', 'comment'];
      }

      function validReportReason(r) {
        return r in [
          'Spam',
          'Wrong information',
          'Abusive content',
          'Inappropriate content',
          'Harassment',
          'Duplicate question',
          'Other'
        ];
      }

      allow read: if approved(caller()) && admin(caller());

      allow create: if approved(caller())
        && validReportTarget(request.resource.data.targetType)
        && validReportReason(request.resource.data.reason)
        && request.resource.data.id == reportId
        && reportId == request.resource.data.targetType + '_'
          + request.resource.data.targetId + '_' + request.auth.uid
        && request.resource.data.targetId is string
        && request.resource.data.targetId.size() > 0
        && request.resource.data.targetId.size() <= 128
        && request.resource.data.targetTitle is string
        && request.resource.data.targetTitle.size() <= 300
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.reporterName is string
        && request.resource.data.reporterName.size() > 0
        && request.resource.data.reporterName.size() <= 100
        && request.resource.data.reportedUserId is string
        && request.resource.data.reportedUserName is string
        && request.resource.data.reportedUserName.size() <= 100
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 1000
        && request.resource.data.status == 'pending'
        && request.resource.data.resolvedById == ''
        && request.resource.data.resolvedAtMs == 0
        && request.resource.data.resolutionNote == ''
        && saneTime(request.resource.data.createdAtMs);

      /** Only a moderator may move a case, and only forward into a closed
       *  state (or reopen it); `resolvedById` is always the acting admin, so
       *  an audit row can never claim a decision nobody made. */
      allow update: if approved(caller())
        && admin(caller())
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'resolvedById', 'resolvedAtMs', 'resolutionNote'])
        && request.resource.data.status in ['pending', 'resolved', 'dismissed']
        && request.resource.data.resolvedById == request.auth.uid
        && request.resource.data.resolutionNote is string
        && request.resource.data.resolutionNote.size() <= 500
        && (request.resource.data.status == 'pending'
            ? (request.resource.data.resolvedAtMs == 0
                && request.resource.data.resolutionNote == '')
            : saneTime(request.resource.data.resolvedAtMs));

      allow delete: if approved(caller()) && admin(caller());
    }

    // ------------------------------------------------------ announcements
    /** Official notices: every approved member reads them, only a
     *  moderator mints or rewrites one, and `authorId` is pinned forever. */
    match /announcements/{announcementId} {

      function validAudience(a) {
        return a in ['all', 'students', 'mentors', 'CSE', 'ECE'];
      }

      allow read: if approved(caller());

      allow create: if approved(caller())
        && admin(caller())
        && request.resource.data.id == announcementId
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() > 0
        && request.resource.data.authorName.size() <= 100
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 200
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 4000
        && request.resource.data.priority in ['low', 'normal', 'urgent']
        && validAudience(request.resource.data.targetAudience)
        && request.resource.data.isActive == true
        && saneTime(request.resource.data.createdAtMs);

      allow update: if approved(caller())
        && admin(caller())
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['title', 'content', 'priority', 'targetAudience', 'isActive', 'updatedAtMs'])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 200
        && request.resource.data.content is string
        && request.resource.data.content.size() > 0
        && request.resource.data.content.size() <= 4000
        && request.resource.data.priority in ['low', 'normal', 'urgent']
        && validAudience(request.resource.data.targetAudience)
        && request.resource.data.isActive is bool
        && saneTime(request.resource.data.updatedAtMs);

      allow delete: if approved(caller()) && admin(caller());
    }

    // ---------------------------------------------------------- auditLogs
    /**
     * `auditLogs/{logId}` - append-only trail.
     *
     * `actorId` is pinned to the caller, so nobody can file a decision under
     * somebody else's name; the row is immutable (`update` is refused) and
     * only a moderator may retire one. Read is moderator-only: the trail
     * exists for the people who have to answer for it.
     */
    match /auditLogs/{logId} {
      allow read: if approved(caller()) && admin(caller());

      allow create: if approved(caller())
        // A trail only the moderators can append to: without this the row is
        // readable by nobody but still writable by everybody, which is how a
        // student would file decisions under their own name.
        && admin(caller())
        && request.resource.data.id == logId
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.actorName is string
        && request.resource.data.actorName.size() > 0
        && request.resource.data.actorName.size() <= 100
        && request.resource.data.action is string
        && request.resource.data.action.size() > 0
        && request.resource.data.action.size() <= 200
        && request.resource.data.target is string
        && request.resource.data.target.size() <= 300
        && request.resource.data.type in ['user', 'doubt', 'moderation', 'system']
        && saneTime(request.resource.data.createdAtMs);

      allow update: if false;

      allow delete: if approved(caller()) && admin(caller());
    }

    // ---------------------------------------------------------- warnings
    /** Formal academic warnings: moderator-issued, immutable, moderator-read. */
    match /warnings/{warningId} {
      allow read: if approved(caller()) && admin(caller());

      allow create: if approved(caller())
        && admin(caller())
        && request.resource.data.id == warningId
        && request.resource.data.userId is string
        && request.resource.data.userId.size() > 0
        && request.resource.data.userName is string
        && request.resource.data.userName.size() > 0
        && request.resource.data.userName.size() <= 100
        && request.resource.data.reason is string
        && request.resource.data.reason.size() >= 5
        && request.resource.data.reason.size() <= 500
        && request.resource.data.issuedById == request.auth.uid
        && request.resource.data.issuedByName is string
        && request.resource.data.issuedByName.size() > 0
        && saneTime(request.resource.data.createdAtMs);

      allow update: if false;

      allow delete: if approved(caller()) && admin(caller());
    }

    // ------------------------------------------------------ adminSettings
    /**
     * `adminSettings/singleton` - the moderation policy document.
     * Students never read it, so both branches are provable from `admin()`
     * alone; the field checks keep a policy edit to four validated values.
     */
    match /adminSettings/{settingId} {

      function validSettings(d) {
        return settingId == 'singleton'
          && d.id == 'singleton'
          && d.requireFacultyApproval is bool
          && d.autoFlagSpamWords is bool
          && d.allowedDomain is string
          && d.allowedDomain.size() > 0
          && d.allowedDomain.size() <= 100
          // Anchored, because `matches()` finds a substring: `^\S+$` is the
          // only way to say "the whole domain, no whitespace anywhere" without
          // a `contains()` - which the rules language does not have.
          && d.allowedDomain.matches('^\\S+$')
          && d.minRepToComment is number
          && d.minRepToComment >= 0
          && d.minRepToComment <= 1000000;
      }

      allow read: if approved(caller()) && admin(caller());

      allow create: if approved(caller())
        && admin(caller())
        && validSettings(request.resource.data)
        && saneTime(request.resource.data.updatedAtMs)
        && request.resource.data.updatedBy == request.auth.uid;

      allow update: if approved(caller())
        && admin(caller())
        && validSettings(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly([
              'requireFacultyApproval',
              'autoFlagSpamWords',
              'allowedDomain',
              'minRepToComment',
              'updatedAtMs',
              'updatedBy'
            ])
        && saneTime(request.resource.data.updatedAtMs)
        && request.resource.data.updatedBy == request.auth.uid;

      allow delete: if false;
    }

    // ------------------------------------------------------------ messaging
    /**
     * Direct messages.
     *
     *   conversations/{a_b}                  one document per member pair
     *   conversations/{a_b}/messages/{id}    the thread itself
     *   conversationReads/{a_b}_{uid}        one member's own read receipt
     *
     * The conversation id is its two participants in ascending order, so a
     * pair can only ever own ONE conversation, and every rule below re-reads
     * the parent and requires the caller to be one of its two members.
     * Knowing (or guessing) a document id is therefore never enough to read
     * somebody else's thread - the same guarantee the private doubts rely on.
     *
     * Read receipts live in their own collection precisely so that each
     * member can move only their own: a map field on the conversation would
     * have no way to prove that in rules.
     */
    match /conversations/{conversationId} {

      /** The caller may only ever be a member of a pair they named. */
      function selfConversation(p) {
        return p is list
          && p.size() == 2
          && p[0] is string
          && p[1] is string
          && p[0] != p[1]
          && p[0] < p[1]
          && conversationId == p[0] + '_' + p[1]
          && (request.auth.uid == p[0] || request.auth.uid == p[1]);
      }

      function threadMember() {
        return approved(caller())
          && request.auth.uid in resource.data.participants;
      }

      allow get, list: if threadMember();

      allow create: if approved(caller())
        && selfConversation(request.resource.data.participants)
        && request.resource.data.id == conversationId
        && memberStatus(request.resource.data.participants[0]) == 'approved'
        && memberStatus(request.resource.data.participants[1]) == 'approved'
        && saneTime(request.resource.data.createdAtMs)
        && request.resource.data.updatedAtMs == request.resource.data.createdAtMs
        && request.resource.data.lastMessageAtMs == 0
        && request.resource.data.lastMessageSenderId == ''
        && request.resource.data.lastMessagePreview == '';

      /** Activity bookkeeping only: participants and identity are frozen, so
       *  a conversation can never be re-pointed at a different member. */
      allow update: if threadMember()
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['updatedAtMs', 'lastMessageAtMs', 'lastMessageSenderId', 'lastMessagePreview'])
        && request.resource.data.participants == resource.data.participants
        && request.resource.data.id == resource.data.id
        && request.resource.data.createdAtMs == resource.data.createdAtMs
        && saneTime(request.resource.data.updatedAtMs)
        && saneTime(request.resource.data.lastMessageAtMs)
        && request.resource.data.lastMessageAtMs >= resource.data.lastMessageAtMs
        && request.resource.data.lastMessageSenderId is string
        && (request.resource.data.lastMessageSenderId == ''
            || request.resource.data.lastMessageSenderId in request.resource.data.participants)
        && request.resource.data.lastMessagePreview is string
        && request.resource.data.lastMessagePreview.size() <= 200;

      allow delete: if threadMember() || admin(caller());

      // ----------------------------------------------------------- messages
      match /messages/{messageId} {

        function parentConversation() {
          return get(/databases/$(database)/documents/conversations/$(conversationId)).data;
        }

        function threadReader() {
          return approved(caller())
            && request.auth.uid in parentConversation().participants;
        }

        allow get, list: if threadReader();

        allow create: if threadReader()
          // Read and write are the same membership test. Checking only the
          // receiver would let ANY approved member inject a message into
          // anyone else's thread by naming one of its two members as the
          // receiver - the sender must belong to the pair too.
          && request.resource.data.id == messageId
          && request.resource.data.conversationId == conversationId
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.receiverId is string
          && request.resource.data.receiverId != request.auth.uid
          && request.resource.data.receiverId in parentConversation().participants
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 4000
          && (request.resource.data.codeSnippet == null
            || (request.resource.data.codeSnippet is map
              && request.resource.data.codeSnippet.language is string
              && request.resource.data.codeSnippet.language.size() <= 40
              && request.resource.data.codeSnippet.code is string
              && request.resource.data.codeSnippet.code.size() <= 20000))
          && saneTime(request.resource.data.createdAtMs);

        /** A message is evidence: never edited, only removed by its author
         *  or a moderator. Read state lives in `conversationReads`. */
        allow update: if false;

        allow delete: if approved(caller())
          && (resource.data.senderId == request.auth.uid || admin(caller()));
      }
    }

    /**
     * `conversationReads/{conversationId}_{uid}` - one member's own cursor.
     * Nobody else can read it, and `lastReadAtMs` only ever moves forward,
     * so a receipt can neither be forged for someone else nor rewound.
     */
    match /conversationReads/{readId} {
      allow read: if approved(caller()) && resource.data.userId == request.auth.uid;

      allow create: if approved(caller())
        && readId == request.resource.data.conversationId + '_' + request.auth.uid
        && request.resource.data.id == readId
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.conversationId is string
        && request.resource.data.conversationId.size() > 0
        && request.auth.uid in get(
            /databases/$(database)/documents/conversations/$(request.resource.data.conversationId)
          ).data.participants
        && saneTime(request.resource.data.lastReadAtMs);

      allow update: if approved(caller())
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastReadAtMs'])
        && saneTime(request.resource.data.lastReadAtMs)
        && request.resource.data.lastReadAtMs >= resource.data.lastReadAtMs;

      allow delete: if approved(caller()) && resource.data.userId == request.auth.uid;
    }

    // ------------------------------------------------------- everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
