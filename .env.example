# Firebase web app configuration
# (Firebase console > Project settings > Your apps > SDK setup and configuration)
#
# These values IDENTIFY your Firebase app; they are not secret credentials by
# themselves. Security is enforced by Firebase Auth, Firestore/Storage Security
# Rules and App Check — never by hiding this config.
#
# Copy this file to `.env` (git-ignored) and fill in real values.
# Never commit `.env`, service-account JSON or private keys.

VITE_FIREBASE_API_KEY=AIzaSyAFzRtoLd6LE6GJItIPBbph4vcKiR5P4Y
VITE_FIREBASE_AUTH_DOMAIN=connect-yb.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=connect-yb
VITE_FIREBASE_STORAGE_BUCKET=connect-yb.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=67449910630
VITE_FIREBASE_APP_ID=1:67449910630:web:398cda608ac8d73f3bc4a7
VITE_FIREBASE_MEASUREMENT_ID=G-PBY29HPN3Q

# Optional — Google Analytics for Firebase
# VITE_FIREBASE_MEASUREMENT_ID=""

# Admin bootstrap scripts only (scripts/) — never read by the web app.
# Firestore database id. The Admin SDK must be given this explicitly: without
# it, implicit database resolution fails with gRPC `5 NOT_FOUND`.
FIRESTORE_DATABASE_ID=default

# APP_URL: public URL of the deployment (self-referential links, callbacks).
APP_URL="MY_APP_URL"
