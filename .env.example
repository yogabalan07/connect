# Firebase web app configuration
# (Firebase console > Project settings > Your apps > SDK setup and configuration)
#
# These values IDENTIFY your Firebase app; they are not secret credentials by
# themselves. Security is enforced by Firebase Auth, Firestore/Storage Security
# Rules and App Check — never by hiding this config.
#
# Copy this file to `.env` (git-ignored) and fill in real values.
# Never commit `.env`, service-account JSON or private keys.

VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# Optional — Google Analytics for Firebase
# VITE_FIREBASE_MEASUREMENT_ID=""

# APP_URL: public URL of the deployment (self-referential links, callbacks).
APP_URL="MY_APP_URL"
